PORT=3000

# MySQL — same database as Spring Boot backend
DB_HOST=localhost
DB_PORT=3306
DB_NAME=traffic_db
DB_USER=root
DB_PASSWORD=root

# Redis — same instance as Spring Boot backend
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue key in Redis
QUEUE_KEY=traffic:upload:queue

# Worker batch interval (ms) — how long to wait before re-querying after empty queue
WORKER_IDLE_MS=500
